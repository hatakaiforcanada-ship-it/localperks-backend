{
  "info": {
    "name": "LocalPerks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api/v1" },
    { "key": "phone", "value": "+14155552671" },
    { "key": "code", "value": "123456" },
    { "key": "token", "value": "" },
    { "key": "businessId", "value": "1" },
    { "key": "offerId", "value": "1" }
  ],
  "item": [
    {
      "name": "Request verification code",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/users/code?phone={{phone}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "code"],
          "query": [{ "key": "phone", "value": "{{phone}}" }]
        }
      }
    },
    {
      "name": "Login",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const body = pm.response.json();",
            "if (body.success && body.data) pm.collectionVariables.set('token', body.data);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{code}}\"\n}"
        },
        "url": "{{baseUrl}}/users/login"
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Business details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/businesses/{{businessId}}"
      }
    },
    {
      "name": "Claim limited-time offer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/offers/{{offerId}}/claim"
      }
    }
  ]
}
